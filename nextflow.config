/*
 * Human-DNAseq-chr20-nf-dsl2 pipeline configuration
 */

params {
    // Primary input: CSV samplesheet with columns sample_id,reads_bam
    input           = null

    // Reference genome + accessory files
    reference       = null
    reference_index = null
    reference_dict  = null
    intervals       = null

    // Base name for the final joint-called VCF
    cohort_name     = 'cohort'

    // Where to publish results
    outdir          = 'results'

    // Print the pipeline help message and exit
    help            = false
}

manifest {
    name            = 'Human-DNAseq-chr20-nf-dsl2'
    description     = 'Germline short variant calling (per-sample + joint genotyping) with Samtools and GATK4'
    author          = ''
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '1.0.0'
}

// Schema-driven parameter validation and --help (see nextflow_schema.json).
// Pinned to the last release still compatible with Nextflow >=24.10.0 —
// nf-schema 2.5.0+ requires >=25.04.0, and 2.6.0+ requires >=25.10.0.
plugins {
        id 'nf-schema@2.7.2'
}

validation {
    help {
        enabled = true
        command = "nextflow run main.nf --input samplesheet.csv --reference ref.fasta --reference_index ref.fasta.fai --reference_dict ref.dict --intervals intervals.bed -profile docker"
    }
}

process {
    executor = 'local'
    cpus     = 1
    memory   = '2 GB'

    // Resource tiers, applied per-process via `label` in modules/*.nf
    withLabel: process_low {
        cpus   = 1
        memory = '2 GB'
    }
    withLabel: process_medium {
        cpus   = 2
        memory = '4 GB'
    }

    // Retry once with more resources on OOM-kill / SIGTERM exit codes,
    // otherwise fail the run instead of hanging.
    errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2
}

// Default container engine. Override with -profile conda / -profile singularity.
docker.enabled = true

profiles {
    docker {
        docker.enabled      = true
        conda.enabled       = false
        singularity.enabled = false
    }

    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled          = false
        conda.enabled           = false
    }

    // Run with the small bundled family-trio test dataset (chr20 slice)
    test {
        params.input           = "${projectDir}/data/samplesheet.csv"
        params.reference       = "${projectDir}/data/ref/ref.fasta"
        params.reference_index = "${projectDir}/data/ref/ref.fasta.fai"
        params.reference_dict  = "${projectDir}/data/ref/ref.dict"
        params.intervals       = "${projectDir}/data/ref/intervals.bed"
        params.cohort_name     = "family_trio"
    }
}

// Execution reports, regenerated fresh on every run for provenance/auditing
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
