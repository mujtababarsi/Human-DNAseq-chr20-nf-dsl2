{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/OWNER/nf-dnaseq/master/assets/schema_input.json",
    "title": "nf-dnaseq samplesheet schema",
    "description": "Schema for the samplesheet passed to nf-dnaseq via --input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample_id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample ID must be provided and must not contain spaces",
                "meta": ["id"]
            },
            "reads_bam": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.bam$",
                "errorMessage": "reads_bam must be provided, must exist, and must have extension '.bam'"
            }
        },
        "required": ["sample_id", "reads_bam"]
    }
}
