nextflow_workflow {

    name "Test workflow DNASEQ_WORKFLOW"
    script "workflows/dnaseq.nf"
    workflow "DNASEQ_WORKFLOW"

    test("Should call variants per-sample and jointly genotype the family trio") {

        when {
            params {
                reference       = "${projectDir}/data/ref/ref.fasta"
                reference_index = "${projectDir}/data/ref/ref.fasta.fai"
                reference_dict  = "${projectDir}/data/ref/ref.dict"
                intervals       = "${projectDir}/data/ref/intervals.bed"
                cohort_name     = "family_trio"
                input           = "${projectDir}/data/samplesheet.csv"
            }
            workflow {
                """
                input[0] = Channel.of(
                    tuple('NA12878', file("${projectDir}/data/bam/reads_mother.bam")),
                    tuple('NA12877', file("${projectDir}/data/bam/reads_father.bam")),
                    tuple('NA12882', file("${projectDir}/data/bam/reads_son.bam"))
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.indexed_bam.size() == 3
            assert workflow.out.gvcf.size() == 3
            assert workflow.out.joint_vcf.size() == 1
            assert workflow.out.bcftools_stats.size() == 1
            assert workflow.out.multiqc_report.size() == 1

            def joint_vcf = workflow.out.joint_vcf[0]
            assert file(joint_vcf).name == 'family_trio.joint.vcf'

            def header_line = file(joint_vcf).readLines().find { it.startsWith('#CHROM') }
            assert header_line != null
            assert header_line.contains('NA12878') || header_line.contains('reads_mother')

            // No annotation params set: every annotation step is skipped
            assert workflow.out.annotated_vcf == workflow.out.joint_vcf
            assert workflow.out.annotation_summary.size() == 0
            assert workflow.out.de_novo.size() == 0
        }
    }

    test("Should shift, ClinVar-annotate and trio-filter the joint VCF") {

        when {
            params {
                reference            = "${projectDir}/data/ref/ref.fasta"
                reference_index      = "${projectDir}/data/ref/ref.fasta.fai"
                reference_dict       = "${projectDir}/data/ref/ref.dict"
                intervals            = "${projectDir}/data/ref/intervals.bed"
                cohort_name          = "family_trio"
                input                = "${projectDir}/data/samplesheet.csv"
                contig_offset        = 10037292
                source_contig        = '20_10037292_10066351'
                target_contig        = '20'
                target_contig_length = 63025520
                clinvar              = "${projectDir}/data/annotation/clinvar_region.vcf.gz"
                proband              = 'reads_son'
                father               = 'reads_father'
                mother               = 'reads_mother'
            }
            workflow {
                """
                input[0] = Channel.of(
                    tuple('reads_mother', file("${projectDir}/data/bam/reads_mother.bam")),
                    tuple('reads_father', file("${projectDir}/data/bam/reads_father.bam")),
                    tuple('reads_son',    file("${projectDir}/data/bam/reads_son.bam"))
                )
                """
            }
        }

        then {
            assert workflow.success
            assert file(workflow.out.annotated_vcf[0]).name == 'family_trio.clinvar.vcf.gz'
            assert workflow.out.ref_check.size() == 0     // no --ref_check_fasta
            assert workflow.out.snpeff_html.size() == 0   // no --snpeff_db

            // Expected values from the manual analysis (README "Annotation")
            assert file(workflow.out.annotation_summary[0]).readLines() == [
                'metric\tcount',
                'total_variants\t18',
                'clinvar_annotated\t0',
                'protein_altering\tNA',
                'de_novo\t0'
            ]
        }
    }

    test("Should fail fast on an empty input channel") {

        when {
            params {
                reference       = "${projectDir}/data/ref/ref.fasta"
                reference_index = "${projectDir}/data/ref/ref.fasta.fai"
                reference_dict  = "${projectDir}/data/ref/ref.dict"
                intervals       = "${projectDir}/data/ref/intervals.bed"
                cohort_name     = "family_trio"
                input           = "${projectDir}/data/samplesheet.csv"
            }
            workflow {
                """
                input[0] = Channel.empty()
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.toString().contains('No samples found') || workflow.errorReport.contains('No samples found')
        }
    }
}
